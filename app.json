{
  "expo": {
    "name": "The Sweat Locker",
    "slug": "sweatlocker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sweatlocker.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#22323E"
      },
      "package": "com.sweatlocker.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#22323E",
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ],
    "scheme": "sweatlocker",
    "extra": {
      "eas": {
        "projectId": "074e9e82-8903-42b2-b90b-fcb2fe20a1f2"
      }
    },
    "owner": "sweatshop"
  }
}
